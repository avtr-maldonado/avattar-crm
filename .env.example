# ---------------------------------------------------------------------------
# Supabase · Auth (Entra ID) y Storage
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Prisma · datos
# Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  usa el pooler de Supavisor (puerto 6543, modo transacción).
#               Es la que usa la aplicación en tiempo de ejecución.
# DIRECT_URL    usa la conexión directa (puerto 5432).
#               Es la que necesitan las migraciones y `prisma db seed`.
#
# El pooler en modo transacción no soporta sentencias preparadas con nombre;
# por eso DATABASE_URL lleva ?pgbouncer=true y las migraciones van por DIRECT_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# Solo para operaciones administrativas de Supabase (firmar URLs de Storage,
# alta de usuarios). NUNCA para leer datos de negocio: eso saltaría lib/scope.
SUPABASE_SERVICE_ROLE_KEY=
