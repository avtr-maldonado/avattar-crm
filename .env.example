# Copiar a .env.local y llenar con los valores reales del proyecto Supabase
# (Dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para uso en servidor (Route Handlers, scripts). NUNCA exponer al cliente
# ni prefijar con NEXT_PUBLIC_. Necesaria mientras no existan políticas RLS,
# porque anon/authenticated no pueden leer ni escribir todavía.
SUPABASE_SERVICE_ROLE_KEY=
